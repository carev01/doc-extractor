# ── Required ──────────────────────────────────────────────

# Database (async — used by the app)
DOCEXTRACTOR_DATABASE_URL=postgresql+asyncpg://docextractor:docextractor_dev@localhost:5432/docextractor
# Database (sync — used by Alembic migrations and tests)
DOCEXTRACTOR_DATABASE_URL_SYNC=postgresql+psycopg2://docextractor:docextractor_dev@localhost:5432/docextractor

# Firecrawl (web scraping engine)
DOCEXTRACTOR_FIRECRAWL_API_URL=http://firecrawl.k3s.home.lan
DOCEXTRACTOR_FIRECRAWL_API_KEY=
# URL Firecrawl can call back for per-page webhook events. Leave empty to use polling.
DOCEXTRACTOR_WEBHOOK_BASE_URL=

# ── Authentication (opt-in) ───────────────────────────────

# JWT signing key. EMPTY = auth disabled (dev only).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCEXTRACTOR_AUTH_JWT_SECRET=

# Fernet key for encrypting auth realm credentials at rest.
# Required only when auth realms exist.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCEXTRACTOR_SECRET_KEY=

# OAuth2 providers (optional)
DOCEXTRACTOR_AUTH_OAUTH_REDIRECT_BASE=http://localhost:5173
DOCEXTRACTOR_AUTH_GOOGLE_CLIENT_ID=
DOCEXTRACTOR_AUTH_GOOGLE_CLIENT_SECRET=
DOCEXTRACTOR_AUTH_OKTA_CLIENT_ID=
DOCEXTRACTOR_AUTH_OKTA_CLIENT_SECRET=
DOCEXTRACTOR_AUTH_OKTA_DOMAIN=

# ── Export ────────────────────────────────────────────────

DOCEXTRACTOR_EXPORT_DIR=exports
DOCEXTRACTOR_MAX_ARTICLES_PER_FILE=50
DOCEXTRACTOR_MAX_FILE_SIZE_BYTES=10485760
DOCEXTRACTOR_MAX_TOKENS_PER_FILE=100000
DOCEXTRACTOR_EXPORT_RETENTION_DAYS=7
DOCEXTRACTOR_EXPORT_MAX_TOTAL_BYTES=3221225472

# ── Media ─────────────────────────────────────────────────

DOCEXTRACTOR_MEDIA_DIR=media
DOCEXTRACTOR_MEDIA_URL_PREFIX=/media

# ── LLM Fallback (opt-in) ────────────────────────────────

# When enabled, unrecognized sites are analyzed by an LLM to derive a profile.
DOCEXTRACTOR_LLM_FALLBACK_ENABLED=false
DOCEXTRACTOR_LLM_PROVIDER=anthropic
DOCEXTRACTOR_LLM_BASE_URL=
DOCEXTRACTOR_LLM_API_KEY=
DOCEXTRACTOR_LLM_MODEL=
DOCEXTRACTOR_LLM_MAX_TOKENS=2048

# ── Browserless (optional, for JS-rendered SPAs) ─────────

DOCEXTRACTOR_BROWSERLESS_URL=http://browserless.browserless.svc.cluster.local:3000
DOCEXTRACTOR_BROWSERLESS_TOKEN=
DOCEXTRACTOR_BROWSERLESS_WAIT_MS=9000
DOCEXTRACTOR_BROWSERLESS_CONCURRENCY=4

# ── Raw HTTP engine ──────────────────────────────────────

DOCEXTRACTOR_RAW_HTTP_CONCURRENCY=8
DOCEXTRACTOR_RAW_HTTP_MAX_FAILURE_RATE=0.3
DOCEXTRACTOR_RAW_HTTP_MIN_ATTEMPTS=10

# ── TOC-collapse guard (data-loss protection) ────────────
# Abort a run before the destructive TOC rebuild if its discovered TOC is far
# smaller than the source's live article count — TOC discovery almost certainly
# failed and proceeding would wipe good content. Only engages once a source has
# >= MIN_PRIOR live articles; trips when the new TOC < RATIO * that count.
DOCEXTRACTOR_TOC_COLLAPSE_MIN_RATIO=0.5
DOCEXTRACTOR_TOC_COLLAPSE_MIN_PRIOR=20

# ── Bot-protection blocked-page retry ────────────────────
# When a run finishes with some pages blocked by bot protection
# (Akamai/Cloudflare) but the blocked fraction is at or below this percentage of
# the total scrapable pages, the run does one in-line second pass over just those
# URLs before completing. Above the threshold the pages are left for a manual
# retry (UI button). Set to 0 to disable the automatic pass (manual still works).
DOCEXTRACTOR_BLOCKED_RETRY_MAX_PCT=5.0

# ── PDF Sources (optional) ───────────────────────────────

DOCEXTRACTOR_PDF_DIR=pdf_uploads
DOCEXTRACTOR_PDF_MAX_UPLOAD_BYTES=104857600

# PDF conversion (Layer A): "docling" (default) or "pymupdf" (fallback)
DOCEXTRACTOR_PDF_CONVERTER=docling
DOCEXTRACTOR_DOCLING_SERVE_URL=http://docling.home.lan
DOCEXTRACTOR_DOCLING_SERVE_API_KEY=
DOCEXTRACTOR_DOCLING_SERVE_TIMEOUT=600
DOCEXTRACTOR_DOCLING_SERVE_POLL_INTERVAL=3
DOCEXTRACTOR_DOCLING_SERVE_TRANSIENT_WINDOW=120
DOCEXTRACTOR_DOCLING_SERVE_MAX_RESUBMITS=2
DOCEXTRACTOR_PDF_CONVERT_BATCH_PAGES=80

# VLM escalation (Layer B): re-convert poorly-converted pages via a VLM
DOCEXTRACTOR_PDF_VLM_ESCALATION_ENABLED=true
DOCEXTRACTOR_PDF_VLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
DOCEXTRACTOR_PDF_VLM_API_KEY=
DOCEXTRACTOR_PDF_VLM_MODEL=qwen/qwen3-vl-32b-instruct
DOCEXTRACTOR_PDF_VLM_MAX_PAGES_PCT=10.0
DOCEXTRACTOR_PDF_VLM_MAX_CONSECUTIVE_FAILURES=5

# ── Image descriptions (VLM) ─────────────────────────────
# Opt-in: describe meaningful scraped images (screenshots/diagrams) with a VLM,
# inject captions into article markdown, and surface them in the API + delta feed.
# Set ENABLED=true and provide an API key to turn it on.
DOCEXTRACTOR_IMAGE_VLM_ENABLED=false
DOCEXTRACTOR_IMAGE_VLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
DOCEXTRACTOR_IMAGE_VLM_API_KEY=
DOCEXTRACTOR_IMAGE_VLM_MODEL=qwen/qwen3-vl-32b-instruct
DOCEXTRACTOR_IMAGE_VLM_MAX_PER_RUN=100          # budget: max new descriptions per run
DOCEXTRACTOR_IMAGE_VLM_MAX_CONSECUTIVE_FAILURES=5
DOCEXTRACTOR_IMAGE_VLM_MAX_TOKENS=300
DOCEXTRACTOR_IMAGE_MIN_DIMENSION=100            # px; smaller images treated as decorative
DOCEXTRACTOR_IMAGE_MIN_BYTES=3072               # bytes; smaller images treated as decorative

# ── Webhooks ─────────────────────────────────────────────

# Operator alert webhook (e.g. ntfy/Slack). Blank disables.
DOCEXTRACTOR_NOTIFY_WEBHOOK_URL=
# Allow webhook delivery to private/LAN targets (internal tool default)
DOCEXTRACTOR_WEBHOOK_ALLOW_PRIVATE_TARGETS=true

# ── CORS ─────────────────────────────────────────────────

# Comma-separated or JSON list
DOCEXTRACTOR_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]